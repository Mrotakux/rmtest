{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件 (OpenCV)",
            "command": "D:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-ID:/msys64/ucrt64/include/opencv5",
                "-LD:/msys64/ucrt64/lib",
                "-lopencv_core",
                "-lopencv_imgproc",
                "-lopencv_highgui",
                "-lopencv_videoio",
                "-lopencv_video",
                "-lopencv_imgcodecs",
                "-lopencv_calib",
                "-lopencv_objdetect",
                "-lopencv_features",
                "-lopencv_flann",
                "-lopencv_geometry"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用 MSYS2 UCRT64 g++ 与 OpenCV 5 编译当前文件"
        }
    ],
    "version": "2.0.0"
}